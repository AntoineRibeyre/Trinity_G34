{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:coverage": "ng test --code-coverage",
    "test:watch": "ng test --watch"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.0",
    "@angular/cdk": "^20.2.9",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/material": "^20.2.9",
    "@angular/platform-browser": "^20.3.0",
    "@angular/platform-browser-dynamic": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@apollo/client": "^3.9.0",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "@syncfusion/ej2-angular-charts": "*",
    "@syncfusion/ej2-angular-grids": "^31.1.17",
    "@syncfusion/ej2-angular-schedule": "^31.2.3",
    "@syncfusion/ej2-base": "^31.2.2",
    "@syncfusion/ej2-buttons": "^31.2.3",
    "@syncfusion/ej2-calendars": "^31.2.3",
    "@syncfusion/ej2-dropdowns": "^31.2.3",
    "@syncfusion/ej2-inputs": "^31.2.2",
    "@syncfusion/ej2-lists": "^31.2.2",
    "@syncfusion/ej2-navigations": "^31.2.3",
    "@syncfusion/ej2-popups": "^31.2.2",
    "@syncfusion/ej2-schedule": "^31.2.2",
    "apollo-angular": "^11.0.0",
    "graphql": "^16.8.0",
    "jwt-decode": "^4.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.1",
    "xlsx": "^0.18.5",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.4",
    "@angular/cli": "^20.3.4",
    "@angular/compiler-cli": "^20.3.0",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^24.7.0",
    "@types/xlsx": "^0.0.35",
